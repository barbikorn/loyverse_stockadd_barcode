# ==============================================================
#  .env.example — คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
#  ห้าม commit ไฟล์ .env ขึ้น git!
# ==============================================================

# ─── Loyverse ─────────────────────────────────────────────────
LOYVERSE_TOKEN=your_loyverse_token_here
# LOYVERSE_STORE_ID เป็น optional — ถ้าไม่ระบุจะใช้ทุก store
# LOYVERSE_STORE_ID=your_store_id_here
LOYVERSE_API_BASE=https://api.loyverse.com/v1.0

# ─── Google Sheets (gspread Service Account) ──────────────────
# วางไฟล์ credentials.json ไว้ใน root folder ของโปรเจกต์
GOOGLE_CREDENTIALS_FILE=credentials.json

# ─── Sheet URLs ───────────────────────────────────────────────
# Input Sheet  : รายการสินค้าที่ต้องการ sync
#   ชื่อไฟล์ Google Sheet = category ใน Loyverse (เช่น kornkornkorn)
#   columns required: Name | Type | Quantity Added | Price
#   columns optional: SKU (ถ้าไม่มีจะ auto-generate จากชื่อแท็บ + Mapping Sheet)
INPUT_SHEET_URL=https://docs.google.com/spreadsheets/d/1sZoi_y66NY-G0ni_f6-h2lQg5E61Z_faMxfDAzr8G_4/edit?usp=sharing
# INPUT_SHEET_TAB=peachymooky

# Transaction Sheet : รับผล Success/Error (ทั้ง 2 เลือกได้)
# เลือก: csv (default—ไม่ต้องใช้ credentials.json) หรือ sheets
TRANSACTION_OUTPUT_MODE=csv

# --- ถ้า MODE=csv ---
TRANSACTION_CSV_PATH=output/transactions.csv

# --- ถ้า MODE=sheets ---
TRANSACTION_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_TRANSACTION_SHEET_ID/edit#gid=0
TRANSACTION_SHEET_NAME=Transactions

# Mapping Sheet : ชื่อไฟล์ Google Sheet → prefix (2 columns: category, prefix)
MAPPING_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_MAPPING_SHEET_ID/edit#gid=0
MAPPING_SHEET_NAME=Mapping

# ─── Column names (ต้องตรงกับ header ใน sheet) ───────────────
SHEET_COL_PRODUCT_NAME=Name
# SHEET_COL_SKU เป็น optional — ถ้าไม่มีในชีตจะ auto-generate จากชื่อไฟล์
# SHEET_COL_SKU=SKU
SHEET_COL_QTY=Add Number
SHEET_COL_STATUS=Status
SHEET_COL_MESSAGE=Message

# ─── SKU Generator ────────────────────────────────────────────
SKU_DIGIT_PAD=3

# ─── Local Output ─────────────────────────────────────────────
# barcode PNG → output/{YYYYMMDD}/{ชื่อไฟล์ Google Sheet}/
# BARCODE_OUTPUT_DIR_PREFIX=barcodes
REPORT_FILENAME_PREFIX=loyverse_sync_report

# ─── Sales by Category report (/reports/sales) ────────────────
# REPORT_TIMEZONE=Asia/Bangkok
# REPORT_MAX_RANGE_DAYS=366
# REPORT_CATALOG_TTL_SEC=600
# REPORT_CURRENCY_SYMBOL=฿
